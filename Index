  async function loadComps(){ try { comps = await run('listComponents', token, cur.id); drawComps(); fillMeterNos(); ownerOpts(); loadPhotos(); renderOv(); } catch(e){ if (!kick(e)) $('compErr').textContent = e.message; } }
