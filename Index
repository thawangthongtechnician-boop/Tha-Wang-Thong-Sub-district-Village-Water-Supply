      while (idx < files.length && !stop) {
        const f = files[idx++];
        try { const url = await shrink(f); await run('uploadPhoto', token, cur.id, o[0], o[1], url, cap); }
        catch(err){ if (kick(err)) { stop = true; return; } fail++; }
        done++; $('phErr').textContent = 'กำลังอัปโหลด ' + done + '/' + files.length;
      }
    };
    await Promise.all([worker(), worker(), worker()]);
    e.target.value = ''; $('ph_cap').value = '';
    $('phErr').style.color = fail ? '' : '#2e7d32'; $('phErr').textContent = 'อัปโหลดแล้ว ' + (files.length - fail) + ' รูป' + (fail ? ' (ล้มเหลว ' + fail + ' รูป)' : '');
    loadPhotos();
  };
})();
