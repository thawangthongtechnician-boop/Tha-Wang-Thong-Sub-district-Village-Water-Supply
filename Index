    B.querySelectorAll('[data-m]').forEach(b => { b.onclick = () => msOpen(b.dataset.m, b.dataset.ex, b); });
    $('i_prev').style.visibility = step ? 'visible' : 'hidden'; $('i_next').style.display = step < STEPS.length - 1 ? '' : 'none';
    $('i_draft').style.display = ro ? 'none' : ''; $('i_done').style.display = (!ro && step === STEPS.length - 1) ? '' : 'none'; $('i_err').textContent = '';
    if (ro) B.querySelectorAll('input,select,textarea').forEach(e => e.disabled = true);
    window.scrollTo(0, 0);
  }
  function msOpen(k, ex, btn){
    const sel = [].concat(D[k] || []), M = $('msBox');
    M.innerHTML = '<b>เลือกได้หลายข้อ</b><div style="margin:10px 0">' + (OPT[ex] || []).map(o => '<label style="display:flex;gap:10px;align-items:center;color:var(--text);font-size:17px;padding:8px 0;border-bottom:1px solid var(--line)"><input type="checkbox" value="' + esc(o) + '"' +
      (sel.indexOf(o) >= 0 ? ' checked' : '') + (ro ? ' disabled' : '') + ' style="width:24px;min-height:0;margin:0">' + esc(o) + '</label>').join('') + '</div><button id="msOk" style="width:100%">' + (ro ? 'ปิด' : 'ตกลง') + '</button>';
    $('msModal').style.display = 'flex';
    $('msOk').onclick = () => {
      if (!ro) { D[k] = [...M.querySelectorAll('input:checked')].map(x => x.value); btn.innerHTML = msText(k); const o = $('o_' + k); if (o) o.style.display = hasOther(k) ? 'block' : 'none'; }
      $('msModal').style.display = 'none';
    };
  }
  async function save(status){
    $('i_err').style.color = ''; $('i_err').textContent = '';
    if (!D.date) { $('i_err').textContent = 'กรุณาเลือกวันที่ตรวจสอบ (ขั้นที่ 1)'; return; }
    try {
      eid = await run('saveInspection', token, {id: eid, systemId: cur.id, date: D.date, status: status, overall: D.overall || '', data: JSON.stringify(D)});
      $('i_err').style.color = '#2e7d32'; $('i_err').textContent = status === 'done' ? 'บันทึกเสร็จสมบูรณ์แล้ว' : 'บันทึกร่างแล้ว';
      if (status === 'done') { view('list'); loadRows(); }
    } catch(e){ if (!kick(e)) $('i_err').textContent = e.message; }
  }
  $('i_next').onclick = () => { step = Math.min(step + 1, STEPS.length - 1); draw(); };
  $('i_prev').onclick = () => { step = Math.max(step - 1, 0); draw(); };
  $('i_back').onclick = () => { view('list'); loadRows(); };
  $('i_draft').onclick = () => save('draft');
  $('i_done').onclick = () => save('done');
})();
</script>
