      ml.map(l => '<tr><td>' + esc(l.name || '-') + '</td><td>' + esc(l.material) + '</td><td>' + esc(l.size) + '</td><td>' + esc(l.year) + '</td><td>' + esc(l.conf) + '</td><td>' + esc(l.length) + '</td></tr>').join('') +
