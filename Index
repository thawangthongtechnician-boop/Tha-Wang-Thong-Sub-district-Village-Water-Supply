</section>

<script>
(function(){
  document.querySelector('main').appendChild($('v-sys'));
  const YRS = Array.from({length: 96}, (_, i) => String(2575 - i));
  const TD = {
    well:{n:'บ่อน้ำบาดาล',f:[['depth','ความลึก (ม.)'],['dia','เส้นผ่านศูนย์กลาง (นิ้ว)'],['yield','ปริมาณน้ำที่สูบได้ (ลบ.ม./ชม.)'],['year','ปีที่เจาะ (พ.ศ.)',YRS]]},
    pump:{n:'ปั๊ม',f:[['kind','ชนิด',['เครื่องสูบน้ำแบบจุ่ม (Submersible)','เครื่องสูบน้ำหอยโข่ง','ชนิดอื่น']],['model','ยี่ห้อ/รุ่น'],['hp','กำลัง (แรงม้า)'],['phase','ไฟ',['1 เฟส','3 เฟส']],['year','ปีที่ติดตั้ง (พ.ศ.)',YRS]]},
    tank:{n:'ถัง/หอถัง',f:[['kind','ชนิดถัง',['ถังสูง','ถัง คสล.','ถังเหล็ก','ถังไฟเบอร์กลาส','อื่น ๆ']],['cap','ความจุ (ลบ.ม.)'],['mat','วัสดุ',['คอนกรีต','เหล็ก','ไฟเบอร์กลาส','อื่น ๆ']]]},
    filter:{n:'ระบบกรอง',f:[['kind','ชนิด'],['year','ปีที่ติดตั้ง (พ.ศ.)',YRS]]},
    meter:{n:'มิเตอร์',f:[['kind','ชนิดมิเตอร์',['ไฟฟ้า','น้ำ']],['number','หมายเลขมิเตอร์ (ไฟ: เลขผู้ใช้ไฟ / น้ำ: เลขที่กรมน้ำบาดาลออกให้)']]}
  };
  const ST = {ok:'✔ ใช้งานได้', partial:'▲ ใช้ได้บางส่วน', broken:'✖ ชำรุด'};
  const SC = {ok:'#2e7d32', partial:'#b26a00', broken:'#b71c1c'};
  const opt = (o) => Object.keys(o).map(k => '<option value="' + k + '">' + (o[k].n || o[k]) + '</option>').join('');
  $('s_status').innerHTML = opt(ST); $('c_status').innerHTML = opt(ST); $('c_type').innerHTML = opt(TD);
  const SF = ['name','village','caretaker','phone','year','builder','households','status','lat','lng','note'];
  let systems = [], cur = null, comps = [], curC = null, watch = null, best = null;

  window.loadSys = async function(){
    sysView('list');
    try { systems = await run('listSystems', token); LI = await run('latestInspections', token); drawSys(); } catch(e){ if (!kick(e)) alert(e.message); }
  };
  function sysView(v){ $('sysList').classList.toggle('hide', v !== 'list'); $('sysEdit').classList.toggle('hide', v !== 'edit'); stopGps(); }
  function drawSys(){
    const q = ($('sysQ').value || '').trim().toLowerCase(), vf = $('sysVf').value;
    const rows = systems.map((s, i) => [s, i]).filter(a => (!vf || a[0].village === vf) && (!q || (a[0].name + ' ' + a[0].caretaker).toLowerCase().indexOf(q) >= 0));
