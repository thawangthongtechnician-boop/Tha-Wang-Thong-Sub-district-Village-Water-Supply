  *{box-sizing:border-box}
  body{margin:0;font-family:'Sarabun',sans-serif;background:var(--bg);color:var(--text);font-size:17px}
  header{background:var(--card);border-bottom:1px solid var(--line);padding:10px 14px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
