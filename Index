  function stopGps(){ if (watch !== null) { navigator.geolocation.clearWatch(watch); watch = null; } $('gpsBtn').textContent = 'ใช้ตำแหน่งปัจจุบัน'; }
  function applyGps(){ if (best) { $('s_lat').value = best.latitude.toFixed(6); $('s_lng').value = best.longitude.toFixed(6); $('gpsInfo').textContent = 'ใช้ตำแหน่งแล้ว (±' + Math.round(best.accuracy) + ' ม.)'; } stopGps(); }
  $('gpsBtn').onclick = () => {
    if (watch !== null) { applyGps(); return; }
