  async function shrink(file){
    let bmp, w, h;
    try { bmp = await createImageBitmap(file, {imageOrientation: 'from-image'}); w = bmp.width; h = bmp.height; }
    catch(e){
      bmp = await new Promise((ok, no) => { const r = new FileReader(); r.onload = () => { const im = new Image(); im.onload = () => ok(im); im.onerror = () => no(new Error('อ่านรูปไม่ได้')); im.src = r.result; }; r.onerror = () => no(new Error('อ่านไฟล์ไม่ได้')); r.readAsDataURL(file); });
      w = bmp.width; h = bmp.height;
    }
    const k = Math.min(1, 1280 / Math.max(w, h)), c = document.createElement('canvas'); c.width = Math.round(w * k); c.height = Math.round(h * k);
    c.getContext('2d').drawImage(bmp, 0, 0, c.width, c.height); if (bmp.close) bmp.close();
    return c.toDataURL('image/jpeg', 0.7);
  }
  $('ph_file').onchange = async e => {
    const files = [...e.target.files]; if (!files.length) return;
