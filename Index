  };

  const PIPES = {};
  const COLP = {'PVC':'#1565c0', 'PE':'#2e7d32', 'เหล็ก':'#6d4c41'}, SZP = ['½ นิ้ว','¾ นิ้ว','1 นิ้ว','1½ นิ้ว','2 นิ้ว','3 นิ้ว','4 นิ้ว','6 นิ้ว'];
  function legend(){
    const ids = Object.keys(PIPES), box = $('pipeLg');
    if (!ids.length) { box.style.display = 'none'; box.innerHTML = ''; return; }
    box.style.display = 'block';
    box.innerHTML = '<b>แนวท่อที่แสดง</b><br>' + ids.map(i => esc(PIPES[i].name) + ' · ' + (Math.round(PIPES[i].total * 10) / 10) + ' ม.').join('<br>') +
      '<div style="margin-top:4px;color:#445">' + [['PVC','#1565c0'], ['PE','#2e7d32'], ['เหล็ก','#6d4c41'], ['อื่น ๆ','#7b1fa2']].map(a => '<span style="color:' + a[1] + '">━</span> ' + a[0]).join(' ') +
      '<br>เส้นประ = ประมาณการ · เส้นทึบ = ยืนยันแล้ว</div><button id="pipesOff" style="min-height:40px;margin-top:8px;width:100%">ซ่อนแนวท่อทั้งหมด</button>';
    $('pipesOff').onclick = () => { ids.forEach(i => { map.removeLayer(PIPES[i].group); delete PIPES[i]; }); legend(); map.closePopup(); };
  }
  async function togglePipes(s, btn){
    if (PIPES[s.id]) { map.removeLayer(PIPES[s.id].group); delete PIPES[s.id]; btn.textContent = '🔧 ดูแนวท่อ'; legend(); return; }
    btn.disabled = true; btn.textContent = 'กำลังโหลด...';
    try {
      const d = await run('listMapData', token, s.id), g = L.layerGroup().addTo(map), pts = []; let total = 0;
      d.lines.forEach(l => {
        let c; try { c = JSON.parse(l.coords); } catch(e){ return; }
        c.forEach(p => pts.push(p)); total += Number(l.length) || 0;
        L.polyline(c, {color: COLP[l.material] || '#7b1fa2', weight: 3 + Math.max(0, SZP.indexOf(l.size)) * 0.6, opacity: .9, dashArray: l.conf === 'ยืนยันแล้ว' ? null : '8 8'})
          .bindPopup('<b>' + esc(l.name || 'ท่อ') + '</b><br>' + esc([l.material, l.size].filter(Boolean).join(' · ')) + '<br>ยาว ' + esc(l.length) + ' ม. · ' + esc(l.conf)).addTo(g);
      });
      d.points.forEach(p => {
        const ll = [parseFloat(p.lat), parseFloat(p.lng)]; if (isNaN(ll[0]) || isNaN(ll[1])) return; pts.push(ll);
        L.circleMarker(ll, {radius: 6, color: '#fff', weight: 2, fillColor: p.kind === 'ท่อแตก/รั่ว' ? '#b71c1c' : '#455a64', fillOpacity: 1}).bindTooltip(esc(p.kind) + (p.name ? ' · ' + esc(p.name) : '')).addTo(g);
      });
      if (!d.lines.length) { map.removeLayer(g); btn.textContent = '🔧 ดูแนวท่อ'; alert('ระบบนี้ยังไม่มีแนวท่อ (วาดได้ที่แท็บ "แผนที่ท่อ" ในหน้าระบบประปา)'); }
      else { PIPES[s.id] = {group: g, total: total, name: s.name}; btn.textContent = '🙈 ซ่อนแนวท่อ'; if (pts.length) map.fitBounds(pts, {padding: [40, 40], maxZoom: 19}); legend(); }
    } catch(e){ if (!kick(e)) alert(e.message); btn.textContent = '🔧 ดูแนวท่อ'; }
    btn.disabled = false;
  }

  function initMap(){
    if (map) return true;
    if (typeof L === 'undefined') { $('noGeo').textContent = 'โหลดแผนที่ไม่ได้ (ตรวจอินเทอร์เน็ต แล้วลองรีเฟรช)'; return false; }
    map = L.map('map', {maxZoom: 21}).setView([19.17, 99.90], 12);
    const osm = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {maxZoom:21, maxNativeZoom:19, attribution:'© OpenStreetMap'});
    const sat = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {maxZoom:21, maxNativeZoom:18, attribution:'Imagery © Esri'});
    const clarity = L.tileLayer('https://clarity.maptiles.arcgis.com/arcgis/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {maxZoom:21, maxNativeZoom:18, attribution:'Imagery © Esri'});
    const sat17 = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {maxZoom:21, maxNativeZoom:17, attribution:'Imagery © Esri'});
    const labels = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}', {maxZoom:21, maxNativeZoom:18, attribution:'© Esri'});
    osm.addTo(map); L.control.layers({'แผนที่ถนน':osm, 'ดาวเทียม':sat, 'ดาวเทียม (Clarity ชัดขึ้น)':clarity, 'ดาวเทียม (ซูมลึก ไม่มีช่องว่าง)':sat17}, {'ชื่อสถานที่/ถนน':labels}).addTo(map);
    layer = L.layerGroup().addTo(map);
    return true;
  }

  function draw(){
    const v = $('d_village').value, st = $('d_status').value;
    const list = all.filter(s => (!v || s.village === v) && (!st || s.status === st));
    const n = k => list.filter(s => s.status === k).length;
    $('kpi').innerHTML = [['ทั้งหมด', list.length, '#263238'], [ST.ok, n('ok'), SC.ok], [ST.partial, n('partial'), SC.partial], [ST.broken, n('broken'), SC.broken], ['ผลตรวจ: ต้องปรับปรุง/เร่งด่วน', list.filter(s => LI[s.id] && (LI[s.id].overall === 'ต้องปรับปรุง' || LI[s.id].overall === 'เร่งด่วน')).length, '#c2571a'], ['ยังไม่เคยตรวจ', list.filter(s => !LI[s.id]).length, '#667']]
      .map(([t, x, c]) => '<div class="card" style="margin:0;text-align:center"><div style="font-size:32px;font-weight:600;color:' + c + '">' + x + '</div><div>' + t + '</div></div>').join('');
    const cut = (() => { const d = new Date(); d.setFullYear(d.getFullYear() - 1); return d.toISOString().slice(0, 10); })();
    const need = list.filter(s => !LI[s.id] || LI[s.id].date < cut);
    window.NOINS_HTML = '<b>ยังไม่เคยตรวจ หรือตรวจเกิน 12 เดือน: ' + need.length + ' แห่ง</b>' + (need.length ? need.map(s => '<div style="display:flex;gap:8px;align-items:center;padding:8px 0;border-bottom:1px solid var(--line)"><div style="flex:1">' + esc(s.name) + '<br><span style="color:var(--mute);font-size:15px">' + esc(vname(s.village)) + ' · ' + (LI[s.id] ? 'ตรวจล่าสุด ' + LI[s.id].date : 'ยังไม่เคยตรวจ') + '</span></div><button class="sec" onclick="pickIns(\'' + s.id + '\')">เปิด</button></div>').join('') : '<div style="color:#2e7d32">✔ ตรวจครบแล้ว</div>');
    $('noInsBtn').textContent = 'ยังไม่ตรวจ/เกิน 12 เดือน (' + need.length + ')';
    if (!initMap()) return;
    layer.clearLayers();
    const pts = []; let miss = 0;
    list.forEach(s => {
      const la = parseFloat(s.lat), ln = parseFloat(s.lng);
      if (isNaN(la) || isNaN(ln)) { miss++; return; }
      pts.push([la, ln]);
      const ic = L.divIcon({className:'', iconSize:[30,30], iconAnchor:[15,15],
        html:'<div style="width:30px;height:30px;border-radius:50%;background:' + SC[s.status] + ';color:#fff;border:2px solid #fff;box-shadow:0 1px 4px #0006;display:flex;align-items:center;justify-content:center;font-size:15px">' + SY[s.status] + '</div>'});
      const wrap = document.createElement('div');
      wrap.innerHTML = '<b>' + esc(s.name) + '</b><br>' + esc(vname(s.village)) + '<br><span style="color:' + SC[s.status] + '">' + ST[s.status] + '</span>' +
        '<br>ผลตรวจล่าสุด: ' + (LI[s.id] ? esc(LI[s.id].overall || '-') + ' (' + LI[s.id].date + ')' : 'ยังไม่เคยตรวจ') + (s.caretaker ? '<br>ผู้ดูแล: ' + esc(s.caretaker) : '') + (s.phone ? '<br><a href="tel:' + esc(s.phone) + '">โทร ' + esc(s.phone) + '</a>' : '') + '<br><a href="https://www.google.com/maps/search/?api=1&query=' + la + ',' + ln + '" target="_blank" rel="noopener">นำทางด้วย Google Maps</a> · <a href="https://earth.google.com/web/search/' + la + ',' + ln + '" target="_blank" rel="noopener">Google Earth</a><br><br>';
      const b = document.createElement('button'); b.textContent = 'ดูรายละเอียด'; b.onclick = () => openSysById(s.id);
      wrap.appendChild(b);
      const pb = document.createElement('button'); pb.className = 'sec'; pb.style.marginLeft = '6px'; pb.textContent = PIPES[s.id] ? '🙈 ซ่อนแนวท่อ' : '🔧 ดูแนวท่อ'; pb.onclick = () => togglePipes(s, pb); wrap.appendChild(pb);
      const mk = L.marker([la, ln], {icon: ic}).addTo(layer).bindPopup(wrap);
      mk.on('popupopen', () => { pb.textContent = PIPES[s.id] ? '🙈 ซ่อนแนวท่อ' : '🔧 ดูแนวท่อ'; });
    });
    if (pts.length) map.fitBounds(pts, {padding:[30, 30], maxZoom:16});
    $('noGeo').textContent = miss ? 'ยังไม่ได้ปักพิกัด ' + miss + ' แห่ง (ไม่แสดงบนแผนที่)' : '';
    setTimeout(() => map.invalidateSize(), 50);
  }
  $('d_village').onchange = draw; $('d_status').onchange = draw;
})();
</script>
<section id="v-read">
  <div class="card">
    <label>งวดเดือน</label><input id="r_period" type="month">
    <label style="display:flex;gap:8px;align-items:center;color:var(--text);margin-top:6px"><input type="checkbox" id="r_remind" style="width:24px;min-height:0;margin:0"> แจ้งเตือนบนแดชบอร์ดเมื่อระบบนี้ยังไม่ส่งค่ามิเตอร์ประจำเดือน</label><div class="err" id="r_remindErr"></div>
  </div>
  <div class="card">
    <b>บันทึกเลขมิเตอร์ประจำเดือน</b><br><br>
    <select id="r_sys" style="display:none"></select>
    <label>วันที่อ่านมิเตอร์</label><input id="r_date" type="date">
    <div id="r_meters"></div>
    <div class="err" id="r_err"></div>
    <button id="r_save">บันทึกค่ารายเดือน</button>
  </div>
  <div id="r_out"></div>
</section>

<script>
(function(){
  $('tab_read').appendChild($('v-read'));
  const MN = ['ม.ค.','ก.พ.','มี.ค.','เม.ย.','พ.ค.','มิ.ย.','ก.ค.','ส.ค.','ก.ย.','ต.ค.','พ.ย.','ธ.ค.'];
  const tp = p => MN[Number(p.slice(5)) - 1] + ' ' + String((Number(p.slice(0, 4)) + 543) % 100);
  const now = new Date(), z = n => ('0' + n).slice(-2);
  let systems = [], data = {meters: [], rows: []};

  window.loadRead = async function(id){
    if (!$('r_period').value) $('r_period').value = now.getFullYear() + '-' + z(now.getMonth() + 1);
    if (!$('r_date').value) $('r_date').value = now.getFullYear() + '-' + z(now.getMonth() + 1) + '-' + z(now.getDate());
    try {
      systems = await run('listSystems', token);
      const keep = $('r_sys').value;
      $('r_sys').innerHTML = systems.length ? systems.map(s => '<option value="' + s.id + '">' + esc(s.name) + ' (' + esc(vname(s.village)) + ')</option>').join('') : '<option value="">ยังไม่มีระบบประปา</option>';
      const want = id || keep; if (want && systems.some(s => s.id === want)) $('r_sys').value = want;
    } catch(e){ if (!kick(e)) $('r_err').textContent = e.message; return; }
    loadSys1();
  };

  async function loadMissing(){
    try {
      const r = await run('listMissing', token, $('m_period').value);
      $('missBox').innerHTML = '<br><b>ยังไม่ส่งค่างวด ' + tp($('m_period').value) + ': ' + r.missing.length + ' ระบบ</b>' +
        (r.missing.length ? r.missing.map(m => '<div style="display:flex;gap:8px;align-items:center;padding:8px 0;border-bottom:1px solid var(--line)"><div style="flex:1">' + esc(m.name) + '<br><span style="color:var(--mute);font-size:15px">' + esc(vname(m.village)) +
          (m.caretaker ? ' · ' + esc(m.caretaker) : '') + (m.phone ? ' · <a href="tel:' + esc(m.phone) + '">' + esc(m.phone) + '</a>' : '') + ' · ขาด ' + m.missing + '/' + m.total + ' มิเตอร์</span></div><button class="sec" onclick="pickRead(\'' + m.id + '\')">กรอก</button></div>').join('') : (r.enabled ? '<div style="color:#2e7d32">✔ ส่งครบแล้ว</div>' : '<div style="color:var(--mute)">ยังไม่ได้เปิดการแจ้งเตือนให้ระบบใด (ติ๊กที่แท็บ "ค่ารายเดือน" ของแต่ละระบบ)</div>')) +
        (r.noMeter ? '<div style="color:var(--mute);margin-top:8px">มี ' + r.noMeter + ' ระบบที่ยังไม่มีองค์ประกอบมิเตอร์ (กรอกหมายเลขมิเตอร์ที่หน้าระบบประปา)</div>' : '');
      $('missBtn').textContent = 'ยังไม่ส่งค่ามิเตอร์ (' + r.missing.length + ')';
    } catch(e){ if (!kick(e)) $('missBox').textContent = e.message; }
  }
  window.loadMissing = loadMissing;
  window.pickRead = id => { $('dlgModal').style.display = 'none'; openSysById(id, 'read'); };

  async function loadSys1(){
    const id = $('r_sys').value;
    if (!id) { $('r_meters').innerHTML = ''; $('r_out').innerHTML = ''; return; }
    try { data = await run('listReadings', token, id); } catch(e){ if (!kick(e)) $('r_err').textContent = e.message; return; }
    const so = systems.find(x => x.id === id); $('r_remind').checked = !!so && so.remind === '1'; $('r_remind').disabled = me.role === 'caretaker';
    drawForm(); drawOut();
  }

  function drawForm(){
    const p = $('r_period').value;
    if (!data.meters.length) { $('r_meters').innerHTML = '<div style="color:var(--mute);margin-bottom:10px">ระบบนี้ยังไม่มีมิเตอร์ ไปที่หน้า "ระบบประปา" เปิดระบบนี้ กรอกหมายเลขมิเตอร์ไฟฟ้า/น้ำ แล้วกดบันทึกก่อน</div>'; return; }
    $('r_meters').innerHTML = data.meters.map(m => {
      const mine = data.rows.filter(r => r.meterId === m.id), prev = mine.filter(r => r.period < p).pop(), ex = mine.find(r => r.period === p);
      return '<div style="border:1px solid var(--line);border-radius:8px;padding:10px;margin:8px 0"><b>' + esc(m.kind) + '</b> · ' + esc(m.name) + (m.number ? ' (เลขที่ ' + esc(m.number) + ')' : '') +
        '<br><span style="color:var(--mute);font-size:15px">ครั้งก่อน: ' + (prev ? esc(prev.value) + ' (' + tp(prev.period) + ')' : 'ยังไม่มี') + '</span>' +
        '<input data-m="' + m.id + '" inputmode="decimal" placeholder="เลขมิเตอร์ปัจจุบัน" value="' + (ex ? esc(ex.value) : '') + '" style="margin-top:6px">' +
        '<label><input type="checkbox" data-r="' + m.id + '"' + (ex && ex.reset === '1' ? ' checked' : '') + ' style="width:auto;min-height:0;margin:0 6px 0 0">เปลี่ยนมิเตอร์/เริ่มนับใหม่</label></div>';
    }).join('');
  }

  function save(force){
    $('r_err').style.color = ''; $('r_err').textContent = '';
    const items = [...$('r_meters').querySelectorAll('input[data-m]')].map(i => ({meterId: i.dataset.m, value: i.value, reset: $('r_meters').querySelector('input[data-r="' + i.dataset.m + '"]').checked}));
    return run('saveReadings', token, $('r_sys').value, $('r_period').value, $('r_date').value, items, !!force).then(n => {
      $('r_err').style.color = '#2e7d32'; $('r_err').textContent = 'บันทึกแล้ว ' + n + ' มิเตอร์'; loadSys1();
    }).catch(e => {
      if (kick(e)) return;
      if (e.message.indexOf('WARN:') === 0) { if (confirm(e.message.slice(5) + '\n\nยืนยันบันทึกค่านี้หรือไม่?')) return save(true); return; }
      $('r_err').textContent = e.message;
    });
  }
  $('r_save').onclick = () => save(false);
  $('r_remind').onchange = async () => {
    const id = $('r_sys').value, on = $('r_remind').checked; $('r_remindErr').textContent = '';
    try { await run('setRemind', token, id, on); const so = systems.find(x => x.id === id); if (so) so.remind = on ? '1' : ''; $('r_remindErr').style.color = '#2e7d32'; $('r_remindErr').textContent = on ? 'เปิดการแจ้งเตือนบนแดชบอร์ดแล้ว' : 'ปิดการแจ้งเตือนแล้ว'; }
    catch(e){ if (!kick(e)) { $('r_remind').checked = !on; $('r_remindErr').style.color = ''; $('r_remindErr').textContent = e.message; } }
  };
  $('r_sys').onchange = loadSys1;
  $('r_period').onchange = drawForm;
  $('m_period').onchange = loadMissing;

  function bar(title, unit, labels, vals, color){
    const ok = vals.some(v => v !== null);
    if (!ok) return '<div class="card"><b>' + title + '</b><div style="color:var(--mute)">ยังไม่มีข้อมูลพอ (ต้องมีค่าอย่างน้อย 2 เดือน)</div></div>';
    const W = 340, H = 170, max = Math.max.apply(null, vals.filter(v => v !== null)) || 1, bw = W / labels.length;
    let s = '<svg viewBox="0 0 ' + W + ' ' + H + '" style="width:100%;height:auto">';
    vals.forEach((v, i) => {
      const x = i * bw + bw * 0.15, w = bw * 0.7;
      if (v !== null) { const h = Math.max(1, (v / max) * 110), y = 130 - h;
        s += '<rect x="' + x + '" y="' + y + '" width="' + w + '" height="' + h + '" fill="' + color + '"/><text x="' + (x + w / 2) + '" y="' + (y - 3) + '" font-size="9" text-anchor="middle" fill="#263238">' + (Math.round(v * 10) / 10) + '</text>'; }
      s += '<text x="' + (x + w / 2) + '" y="148" font-size="9" text-anchor="middle" fill="#667" transform="rotate(-30 ' + (x + w / 2) + ' 148)">' + labels[i] + '</text>';
    });
    return '<div class="card"><b>' + title + '</b> <span style="color:var(--mute)">(' + unit + ')</span>' + s + '</svg></div>';
  }

  function drawOut(){
    const rows = data.rows;
    if (!rows.length) { $('r_out').innerHTML = '<div class="card" style="color:var(--mute)">ยังไม่มีค่าที่บันทึกของระบบนี้</div>'; return; }
    const kind = id => (data.meters.find(m => m.id === id) || {}).kind;
    const per = [...new Set(rows.map(r => r.period))].sort().slice(-12);
    const sum = k => per.map(p => { const u = rows.filter(r => r.period === p && kind(r.meterId) === k && r.usage !== null).map(r => r.usage); return u.length ? u.reduce((a, b) => a + b, 0) : null; });
    const e = sum('ไฟฟ้า'), w = sum('น้ำ'), lb = per.map(tp);
    const ratio = per.map((p, i) => e[i] !== null && w[i] !== null && w[i] > 0 ? e[i] / w[i] : null);
    const hist = rows.slice().sort((a, b) => a.period < b.period ? 1 : -1).map(r => '<tr><td>' + tp(r.period) + '</td><td>' + esc(kind(r.meterId)) + '</td><td>' + esc(r.value) + '</td><td>' + (r.usage === null ? '—' : Math.round(r.usage * 10) / 10) + '</td></tr>').join('');
    $('r_out').innerHTML = bar('หน่วยไฟที่ใช้รายเดือน', 'หน่วย', lb, e, '#607d8b') + bar('น้ำที่สูบรายเดือน', 'ลบ.ม.', lb, w, '#78909c') +
      bar('หน่วยไฟต่อน้ำ 1 ลบ.ม. (ค่าสูงขึ้นเรื่อยๆ อาจแปลว่าปั๊มเริ่มเสื่อม)', 'หน่วย/ลบ.ม.', lb, ratio, '#8d6e63') +
      '<div class="card" style="overflow-x:auto"><b>ประวัติค่ามิเตอร์</b><table><thead><tr><th>งวด</th><th>ชนิด</th><th>เลขมิเตอร์</th><th>ใช้ไป</th></tr></thead><tbody>' + hist + '</tbody></table></div>';
  }
})();
</script>
<section id="v-ins">
  <div id="insList">
    <div class="card"><select id="i_sys" style="display:none"></select><div id="i_new"></div></div>
    <div id="i_rows"></div>
  </div>
  <div id="insForm" style="display:none">
    <div class="card"><button class="sec" id="i_back">← กลับรายการ</button> <b id="i_title"></b><div id="i_prog" style="color:var(--mute);margin-top:6px"></div></div>
    <div class="card" id="i_body"></div>
    <div class="card">
      <div class="err" id="i_err"></div>
      <button class="sec" id="i_prev">← ก่อนหน้า</button> <button id="i_next">ถัดไป →</button>
      <div style="margin-top:10px"><button class="sec" id="i_draft">บันทึกร่าง</button> <button id="i_done">บันทึกเสร็จสมบูรณ์</button></div>
    </div>
