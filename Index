<script>
const $ = id => document.getElementById(id);
const ROLE = {admin:'แอดมิน', officer:'เจ้าหน้าที่', caretaker:'ผู้ดูแลหมู่บ้าน'};
let token = '', me = null, users = [];

const inGas = () => typeof google !== 'undefined' && google.script && google.script.run;
async function apiCall(fn, args){
  const url = (window.APP_CONFIG || {}).API_URL;
  if (!url || /XXXX/.test(url)) throw new Error('ยังไม่ได้ตั้งค่าลิงก์ Apps Script โดยแก้บรรทัด API_URL บนสุดของไฟล์ index.html');
  let res;
  try { res = await fetch(url, {method: 'POST', headers: {'Content-Type': 'text/plain;charset=utf-8'}, body: JSON.stringify({fn: fn, args: args}), redirect: 'follow'}); }
  catch(e){ throw new Error('เชื่อมต่อเซิร์ฟเวอร์ไม่ได้ — ตรวจอินเทอร์เน็ต และลิงก์ API_URL บนสุดของไฟล์ index.html (ต้อง Deploy แบบ Who has access: Anyone)'); }
  let j;
  try { j = await res.json(); } catch(e){ throw new Error('เซิร์ฟเวอร์ตอบกลับผิดรูปแบบ — ตรวจว่าวางโค้ด Code ล่าสุด (มี doPost) และ Deploy เวอร์ชันใหม่แล้ว'); }
  if (!j.ok) throw new Error(j.error || 'เกิดข้อผิดพลาด');
  return j.data;
}
const run = (fn, ...a) => inGas() ? new Promise((ok, no) => {
  const r = google.script.run.withSuccessHandler(ok).withFailureHandler(e => no(new Error(e.message)));
  if (typeof r[fn] !== 'function') return no(new Error('ไม่พบฟังก์ชัน "' + fn + '" บนเซิร์ฟเวอร์ — ให้วางโค้ด Code ล่าสุด แล้ว Deploy เวอร์ชันใหม่ (Manage deployments → แก้ไข → New version)'));
  r[fn](...a);
}) : apiCall(fn, a);
const store = {
  get(){ try{ return sessionStorage.getItem('tk') || ''; }catch(e){ return ''; } },
  set(v){ try{ v ? sessionStorage.setItem('tk', v) : sessionStorage.removeItem('tk'); }catch(e){} }
};
const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

function enter(user){
  me = user; $('login').classList.add('hide'); $('app').classList.remove('hide');
  $('who').textContent = me.name + ' (' + ROLE[me.role] + (me.village ? ' · ' + vname(me.village) : '') + ')';
  
  const items = [['dash','แดชบอร์ด'],['sys','ระบบประปา']]; if (me.role === 'admin') items.push(['users','จัดการผู้ใช้']);
  $('nav').innerHTML = '';
  items.forEach(([k, t]) => { const b = document.createElement('button'); b.textContent = t; b.className = 'sec'; b.onclick = () => show(k); b.dataset.k = k; $('nav').appendChild(b); });
  loadVillages();
  $('kmlWrap').style.display = me.role === 'caretaker' ? 'none' : '';
  show('dash');
}
function show(k){
  if (k === 'users' && me.role !== 'admin') return; // หน้าจัดการผู้ใช้ เฉพาะแอดมิน
  ['dash','users','sys'].forEach(x => $('v-' + x).classList.toggle('hide', x !== k));
  [...$('nav').children].forEach(b => b.classList.toggle('on', b.dataset.k === k));
  if (k === 'users') loadUsers();
  if (k === 'sys') loadSys();
  if (k === 'dash') loadDash();
}
function kick(e){ // หมดอายุ -> กลับหน้าเข้าสู่ระบบ
  if (/หมดอายุ/.test(e.message)) { token = ''; store.set(''); location.reload(); return true; }
  return false;
}

$('lb').onclick = async () => {
  $('le').textContent = ''; $('lb').disabled = true;
  try { const r = await run('login', $('lu').value, $('lp').value); token = r.token; store.set(token); $('lp').value = ''; enter(r.user); }
  catch(e){ $('le').textContent = e.message; }
  $('lb').disabled = false;
};
$('lp').onkeydown = e => { if (e.key === 'Enter') $('lb').click(); };
$('out').onclick = async () => { try{ await run('logout', token); }catch(e){} store.set(''); location.reload(); };


async function loadUsers(){ try { users = await run('listUsers', token); drawUsers(); } catch(e){ if (!kick(e)) $('fe').textContent = e.message; } }
function drawUsers(){
  $('ub').innerHTML = users.map((u, i) => '<tr class="' + (u.active ? '' : 'off') + '"><td>' + esc(u.username) + '</td><td>' + esc(u.name) +
    '</td><td><span class="tag">' + ROLE[u.role] + '</span></td><td>' + esc(vname(u.village)) + '</td><td><button class="sec" onclick="edit(' + i + ')">แก้ไข</button></td></tr>').join('');
}
function edit(i){
  const u = users[i]; $('ft').textContent = 'แก้ไขผู้ใช้: ' + u.username;
  $('fu').value = u.username; $('fu').readOnly = true; $('fn').value = u.name; $('fr').value = u.role; $('fv').value = u.village; $('fp').value = ''; $('fa').checked = u.active;
  window.scrollTo(0, 0);
}
function clearForm(){
  $('ft').textContent = 'เพิ่ม/แก้ไขผู้ใช้'; $('fu').readOnly = false;
  ['fu','fn','fv','fp'].forEach(x => $(x).value = ''); $('fr').value = 'caretaker'; $('fa').checked = true; $('fe').textContent = '';
}
$('fc').onclick = clearForm;
$('fs').onclick = async () => {
  $('fe').style.color = ''; $('fe').textContent = '';
  try {
    users = await run('saveUser', token, {username:$('fu').value, name:$('fn').value, role:$('fr').value, village:$('fv').value, password:$('fp').value, active:$('fa').checked});
    drawUsers(); clearForm(); $('fe').style.color = '#2e7d32'; $('fe').textContent = 'บันทึกแล้ว';
  } catch(e){ if (!kick(e)) $('fe').textContent = e.message; }
};

// กลับเข้าระบบอัตโนมัติถ้ายังมี session
(async () => { const t = store.get(); if (!t) return; try { const u = await run('whoami', t); token = t; enter(u); } catch(e){ store.set(''); } })();
</script>
