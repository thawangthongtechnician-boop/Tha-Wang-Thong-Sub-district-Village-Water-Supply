      addBtn(w, 'แก้ไขข้อมูล', () => { map.closePopup(); lineForm(l, c); });
      addBtn(w, 'แก้ไขรูปร่าง', () => { map.closePopup(); draft = {id: l.id, coords: c.map(p => p.slice()), meta: l}; setMode('line'); });
      if (me.role !== 'caretaker') addBtn(w, 'ลบ', () => { map.closePopup(); del('deleteLine', l.id); });
      pl.bindPopup(w);
    });
    data.points.forEach(p => {
      const k = PTI[p.kind] || ['•', '#546e7a'];
      const mk = L.marker([parseFloat(p.lat), parseFloat(p.lng)], {interactive: ia, icon: L.divIcon({className: '', iconSize: [26, 26], iconAnchor: [13, 13], html: '<div style="width:26px;height:26px;border-radius:50%;background:' + k[1] + ';color:#fff;border:2px solid #fff;box-shadow:0 1px 4px #0006;display:flex;align-items:center;justify-content:center;font-size:13px">' + k[0] + '</div>'})}).addTo(gPts);
      const w = document.createElement('div');
      w.innerHTML = '<b>' + esc(p.kind) + '</b>' + (p.name ? ' · ' + esc(p.name) : '') + (p.note ? '<br>' + esc(p.note) : '') + '<br><br>';
      addBtn(w, 'แก้ไข', () => { map.closePopup(); pointForm(p); });
      addBtn(w, 'ย้ายหมุด', () => { map.closePopup(); mk.dragging.enable(); mk.once('dragend', async () => { const ll = mk.getLatLng(); try { await run('savePoint', token, Object.assign({}, p, {systemId: S.id, lat: ll.lat, lng: ll.lng})); await reload(); } catch(e){ if (!kick(e)) alert(e.message); } }); alert('ลากหมุดไปตำแหน่งใหม่ได้เลย'); });
      if (me.role !== 'caretaker') addBtn(w, 'ลบ', () => { map.closePopup(); del('deletePoint', p.id); });
      mk.bindPopup(w);
    });
    const la = parseFloat(S.lat), ln = parseFloat(S.lng);
    if (!isNaN(la) && !isNaN(ln)) L.circleMarker([la, ln], {radius: 9, color: '#fff', weight: 3, fillColor: '#1565c0', fillOpacity: 1, interactive: false}).bindTooltip(S.name).addTo(gPts);
    const mats = Object.keys(byMat);
    $('pm_sum').innerHTML = '<b>ความยาวท่อรวม ' + (Math.round(total * 10) / 10) + ' เมตร</b> (' + data.lines.length + ' ช่วง)' + (mats.length ? '<br><span style="color:var(--mute)">' + mats.map(m => '<span style="color:' + colOf(m) + '">■</span> ' + esc(m) + ' ' + (Math.round(byMat[m] * 10) / 10) + ' ม.').join(' · ') + '</span>' : '') +
      '<br><span style="color:var(--mute);font-size:15px">เส้นประ = ประมาณการ · เส้นทึบ = ยืนยันแล้ว · ความหนาตามขนาดท่อ · ท่อฝังใต้ดิน ความแม่นยำขึ้นกับข้อมูลที่มี</span>';
  }
  async function reload(){ data = await run('listMapData', token, S.id); drawData(); }
  function fit(){
    const pts = []; data.lines.forEach(l => { try { JSON.parse(l.coords).forEach(p => pts.push(p)); } catch(e){} }); data.points.forEach(p => pts.push([parseFloat(p.lat), parseFloat(p.lng)]));
    const la = parseFloat(S.lat), ln = parseFloat(S.lng); if (!isNaN(la) && !isNaN(ln)) pts.push([la, ln]);
    if (pts.length > 1) map.fitBounds(pts, {padding: [30, 30], maxZoom: 19}); else if (pts.length === 1) map.setView(pts[0], 18); else map.setView([19.17, 99.90], 12);
  }
  window.loadPipeMap = async function(s){
    S = s; build(); if (!map) return;
    setMode(null);
    try { await reload(); } catch(e){ if (!kick(e)) $('pm_sum').textContent = e.message; return; }
    fit(); setTimeout(() => map.invalidateSize(), 120);
  };
})();
</script>
<script>
(function(){
  const STS = ['แจ้งแล้ว','รับเรื่อง','กำลังซ่อม','เสร็จสิ้น','ยกเลิก'], SC = {'แจ้งแล้ว':'#b71c1c', 'รับเรื่อง':'#c2571a', 'กำลังซ่อม':'#b26a00', 'เสร็จสิ้น':'#2e7d32', 'ยกเลิก':'#667'};
  const MN = ['ม.ค.','ก.พ.','มี.ค.','เม.ย.','พ.ค.','มิ.ย.','ก.ค.','ส.ค.','ก.ย.','ต.ค.','พ.ย.','ธ.ค.'];
  const tpd = d => (d && d.length >= 10) ? Number(d.slice(8)) + ' ' + MN[Number(d.slice(5, 7)) - 1] + ' ' + (Number(d.slice(0, 4)) + 543) : '';
  const z = n => ('0' + n).slice(-2), nd = new Date(), TODAY = nd.getFullYear() + '-' + z(nd.getMonth() + 1) + '-' + z(nd.getDate());
  const num = v => Number(v) || 0, tc = r => num(r.parts) + num(r.labor), fb = n => Math.round(n).toLocaleString('th-TH');
  const TN = {well:'บ่อ', pump:'ปั๊ม', tank:'ถัง', filter:'ระบบกรอง', meter:'มิเตอร์'};
  const sel = (id, val, opts) => '<select id="' + id + '"><option value="">— เลือก —</option>' + opts.map(o => '<option' + (o === val ? ' selected' : '') + '>' + esc(o) + '</option>').join('') + '</select>';
  const ta = (id, v) => '<textarea id="' + id + '" rows="2" style="width:100%;font:inherit;padding:8px;border:1px solid #b8bec2;border-radius:8px;margin:4px 0 10px">' + esc(v || '') + '</textarea>';
  let S = null, rows = [], comps = [], OPEN_HTML = '';
  const cname = id => (comps.find(c => c.id === id) || {}).name || 'ทั้งระบบ';

  function build(){
    if ($('rp_list')) return;
    $('tab_rep').innerHTML = '<div class="card"><button id="rp_add">+ แจ้งซ่อม / บันทึกงานซ่อมบำรุง</button></div><div class="card" id="rp_sum"></div><div id="rp_list"></div>';
    $('rp_add').onclick = () => form(null);
  }
  window.loadRepairs = async function(s){
    S = s; build(); $('rp_list').innerHTML = '';
    try { const r = await Promise.all([run('listRepairs', token, s.id), run('listComponents', token, s.id)]); rows = r[0]; comps = r[1]; }
    catch(e){ if (!kick(e)) $('rp_sum').textContent = e.message; return; }
    draw();
  };
  function draw(){
    const d0 = new Date(nd.getFullYear() - 1, nd.getMonth(), nd.getDate()), cut = d0.getFullYear() + '-' + z(d0.getMonth() + 1) + '-' + z(d0.getDate());
    const y = rows.filter(r => r.date >= cut && r.status !== 'ยกเลิก'), fix = y.filter(r => r.kind !== 'บำรุงรักษา');
    const open = rows.filter(r => r.status !== 'เสร็จสิ้น' && r.status !== 'ยกเลิก');
    const dn = y.filter(r => r.status === 'เสร็จสิ้น' && r.doneDate).map(r => (new Date(r.doneDate) - new Date(r.date)) / 86400000).filter(v => v >= 0);
    const by = {}; fix.forEach(r => { const k = cname(r.compId); by[k] = (by[k] || 0) + 1; });
    const top = Object.keys(by).sort((a, b) => by[b] - by[a]).slice(0, 3).map(k => esc(k) + ' (' + by[k] + ' ครั้ง)').join(' · ');
    $('rp_sum').innerHTML = '<b>สรุป 12 เดือนล่าสุด</b><br>ซ่อมแซม ' + fix.length + ' ครั้ง · บำรุงรักษา ' + (y.length - fix.length) + ' ครั้ง · <span style="color:' + (open.length ? '#b71c1c' : '#2e7d32') + '">ยังไม่เสร็จ ' + open.length + ' งาน</span><br>ค่าใช้จ่ายรวม ' + fb(y.reduce((a, r) => a + tc(r), 0)) + ' บาท' +
      (dn.length ? ' · ใช้เวลาซ่อมเฉลี่ย ' + (Math.round(dn.reduce((a, b) => a + b, 0) / dn.length * 10) / 10) + ' วัน' : '') + (top ? '<br>จุดที่เสียบ่อย: ' + top : '');
    $('rp_list').innerHTML = rows.length ? rows.map((r, i) => '<div class="card" style="display:flex;gap:10px;align-items:center"><div style="flex:1"><b>' + tpd(r.date) + '</b> <span style="color:' + SC[r.status] + '">● ' + esc(r.status) + '</span>' + (r.urgency === 'เร่งด่วน' ? ' <span class="tag" style="background:#ffcdd2">เร่งด่วน</span>' : '') +
      '<br>' + esc(r.kind) + ' · ' + esc(cname(r.compId)) + (r.symptom ? ' · ' + esc(r.symptom) : '') + '<br><span style="color:var(--mute);font-size:15px">' + esc([r.support, r.who].filter(Boolean).join(' / ')) + (tc(r) ? ' · ' + fb(tc(r)) + ' บาท' : '') + '</span></div><button class="sec" onclick="openRep(' + i + ')">' + ((me.role === 'caretaker' && r.support === 'ขอเทศบาลช่วย') ? 'ดู' : 'เปิด') + '</button></div>').join('')
      : '<div class="card" style="color:var(--mute)">ยังไม่มีประวัติงานซ่อมบำรุงของระบบนี้ กด "+ แจ้งซ่อม / บันทึกงานซ่อมบำรุง" เพื่อเริ่มบันทึก</div>';
  }
  window.openRep = i => form(rows[i]);
  function form(r){
    const ro = !!r && me.role === 'caretaker' && r.support === 'ขอเทศบาลช่วย'; r = r || {};
    const cOpts = '<option value="">ทั้งระบบ / ไม่ระบุ</option>' + comps.map(c => '<option value="' + c.id + '"' + (r.compId === c.id ? ' selected' : '') + '>' + esc(c.name) + ' (' + (TN[c.type] || '') + ')</option>').join('');
    openDlg('<b>' + (r.id ? 'งานซ่อมบำรุง ' + esc(r.id) : 'แจ้งซ่อม / บันทึกงานซ่อมบำรุง') + '</b>' + (ro ? '<div style="color:var(--mute)">งานที่ขอเทศบาลช่วย แก้ไขได้เฉพาะเจ้าหน้าที่กองช่าง</div>' : '') +
      '<label>ประเภทงาน</label>' + sel('rf_kind', r.kind || 'ซ่อมแซม', OPT.repKind || ['ซ่อมแซม', 'บำรุงรักษา']) + '<label>องค์ประกอบที่เกี่ยวข้อง</label><select id="rf_comp">' + cOpts + '</select>' +
      '<label>วันที่แจ้ง</label><input id="rf_date" type="date" value="' + (r.date || TODAY) + '"><label>อาการ/ปัญหา</label>' + sel('rf_sym', r.symptom, OPT.repSymptom || []) +
      '<label>ความเร่งด่วน</label>' + sel('rf_urg', r.urgency || 'ปกติ', OPT.repUrgency || ['ปกติ', 'เร่งด่วน']) + '<label>ผู้ดำเนินการ</label>' + sel('rf_sup', r.support || 'หมู่บ้านซ่อมเอง', OPT.repSupport || ['หมู่บ้านซ่อมเอง', 'ขอเทศบาลช่วย']) +
      '<label>สถานะงาน</label>' + sel('rf_st', r.status || 'แจ้งแล้ว', STS) + '<label>ช่างผู้ซ่อม</label>' + sel('rf_who', r.who, OPT.repWho || []) +
      '<label>สาเหตุ / รายละเอียด</label>' + ta('rf_cause', r.cause) + '<label>สิ่งที่ดำเนินการ / อะไหล่ที่เปลี่ยน</label>' + ta('rf_act', r.action) +
      '<label>ค่าอะไหล่ (บาท)</label><input id="rf_parts" inputmode="decimal" value="' + esc(r.parts || '') + '"><label>ค่าแรง (บาท)</label><input id="rf_labor" inputmode="decimal" value="' + esc(r.labor || '') + '">' +
      '<label>แหล่งงบประมาณ</label>' + sel('rf_src', r.source, OPT.repSource || []) + '<label>วันที่ซ่อมเสร็จ</label><input id="rf_done" type="date" value="' + (r.doneDate || '') + '"><label>หมายเหตุ</label><input id="rf_note" value="' + esc(r.note || '') + '">' +
      '<div class="err" id="rf_err"></div>' + (ro ? '' : '<button id="rf_save" style="width:100%">บันทึก</button>') + ((!ro && r.id && me.role !== 'caretaker') ? '<button class="sec" id="rf_del" style="width:100%;margin-top:8px;color:#b71c1c">ลบรายการนี้</button>' : ''));
    if (ro) { $('dlgBox').querySelectorAll('input,select,textarea').forEach(e => { e.disabled = true; }); return; }
    $('rf_save').onclick = async () => {
      $('rf_err').textContent = '';
      try {
        await run('saveRepair', token, {id: r.id || '', systemId: S.id, compId: $('rf_comp').value, kind: $('rf_kind').value, date: $('rf_date').value, urgency: $('rf_urg').value, status: $('rf_st').value, symptom: $('rf_sym').value,
          cause: $('rf_cause').value, action: $('rf_act').value, support: $('rf_sup').value, who: $('rf_who').value, parts: $('rf_parts').value, labor: $('rf_labor').value, source: $('rf_src').value, doneDate: $('rf_done').value, note: $('rf_note').value});
        $('dlgModal').style.display = 'none'; loadRepairs(S);
      } catch(e){ if (!kick(e)) $('rf_err').textContent = e.message; }
    };
    if ($('rf_del')) $('rf_del').onclick = async () => {
      if (!confirm('ลบรายการนี้?')) return;
      try { await run('deleteRepair', token, S.id, r.id); $('dlgModal').style.display = 'none'; loadRepairs(S); } catch(e){ if (!kick(e)) $('rf_err').textContent = e.message; }
    };
  }

  // ---- แดชบอร์ด: งานซ่อมค้าง ----
  window.loadOpenRepairs = async function(){
    try {
      const all = await run('listAllRepairs', token), open = all.filter(x => x.status !== 'เสร็จสิ้น' && x.status !== 'ยกเลิก').sort((a, b) => a.date < b.date ? -1 : 1);
      OPEN_HTML = '<b>งานซ่อมที่ยังไม่เสร็จ: ' + open.length + ' งาน</b>' + (open.length ? open.map(x => '<div style="display:flex;gap:8px;align-items:center;padding:8px 0;border-bottom:1px solid var(--line)"><div style="flex:1"><b>' + esc(x.sysName) + '</b> · ' + esc(vname(x.village)) +
        '<br><span style="color:' + SC[x.status] + '">● ' + esc(x.status) + '</span> · ' + esc(x.symptom || '-') + '<br><span style="color:var(--mute);font-size:15px">แจ้ง ' + tpd(x.date) + ' · ' + esc(x.support || '') + '</span></div><button class="sec" onclick="pickRep(\'' + x.systemId + '\')">เปิด</button></div>').join('') : '<div style="color:#2e7d32">✔ ไม่มีงานค้าง</div>');
      $('repOpenBtn').textContent = 'งานซ่อมค้าง (' + open.length + ')';
    } catch(e){ kick(e); }
  };
  window.pickRep = id => { $('dlgModal').style.display = 'none'; openSysById(id, 'rep'); };
  $('repOpenBtn').onclick = () => openDlg(OPEN_HTML || 'กำลังโหลด...');
})();
</script>
<script>
(function(){
  if (inGas()) return;
  try {
    const icon = document.querySelector('link[rel="apple-touch-icon"]').href, base = location.href.split('#')[0].split('?')[0];
    const m = {name: 'ระบบประปาหมู่บ้าน ต.ท่าวังทอง', short_name: 'ประปาท่าวังทอง', start_url: base, scope: base.replace(/[^/]*$/, ''), display: 'standalone', background_color: '#f5f6f7', theme_color: '#455a64', lang: 'th',
      icons: [{src: icon, sizes: '192x192', type: 'image/png'}, {src: icon, sizes: '512x512', type: 'image/png'}]};
    const l = document.createElement('link'); l.rel = 'manifest'; l.href = URL.createObjectURL(new Blob([JSON.stringify(m)], {type: 'application/manifest+json'})); document.head.appendChild(l);
  } catch(e){}
})();
</script>
