  <main>
    

    <section id="v-users" class="hide">
      <div class="card">
        <b id="ft">เพิ่ม/แก้ไขผู้ใช้</b><br><br>
        <label>ชื่อผู้ใช้ (ภาษาอังกฤษ/ตัวเลข)</label><input id="fu" autocapitalize="none">
