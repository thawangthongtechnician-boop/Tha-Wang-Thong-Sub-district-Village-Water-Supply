      ((!isNaN(la) && !isNaN(ln)) ? '<a style="' + ab + '" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=' + la + ',' + ln + '">🧭 นำทาง</a>' : '') +
      '<button class="sec" onclick="openRptSys(\'' + cur.id + '\')">🖨 พิมพ์รายงาน</button><button class="sec" id="phOpen">🖼 รูปภาพ (' + photos.length + ')</button></div></div>' +
      '<div class="card">' + (info || '<span style="color:var(--mute)">ยังไม่มีข้อมูลเพิ่มเติม กด ✎ แก้ไขข้อมูล เพื่อเพิ่ม</span>') + '</div>';
    $('phOpen').onclick = () => mdl('m_ph', true);
